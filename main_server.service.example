[Unit]
Description=AI Server Manager (main_server)
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/main_server_new
ExecStart=/srv/main_server_new/.venv/bin/python /srv/main_server_new/app.py
Restart=always
RestartSec=5
# AI model mmap/page-cache and ComfyUI CPU staging can create sustained memory
# pressure even when swap and reclaimable memory are still available. Keep
# systemd-oomd from killing the manager together with all managed workloads.
ManagedOOMPreference=omit
User=flux
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
