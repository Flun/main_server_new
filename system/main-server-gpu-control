#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR=/etc/main-server/gpu-tune.d
NVIDIA_SETTINGS=/usr/local/bin/nvidia-settings-610

die() { echo "$*" >&2; exit 2; }
is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
trim() { local value=$1; value=${value#"${value%%[![:space:]]*}"}; value=${value%"${value##*[![:space:]]}"}; printf '%s' "$value"; }

resolve_gpu() {
  local selector=$1 line
  line=$(nvidia-smi -i "$selector" --query-gpu=index,uuid,name,pci.device_id,power.min_limit,power.max_limit,power.default_limit,clocks.max.graphics,fan.speed --format=csv,noheader,nounits 2>/dev/null) || die "GPU를 찾을 수 없습니다: $selector"
  IFS=, read -r GPU_INDEX GPU_UUID GPU_NAME PCI_DEVICE_ID POWER_MIN POWER_MAX POWER_DEFAULT CLOCK_HARDWARE_MAX FAN_CURRENT <<<"$line"
  GPU_INDEX=$(trim "$GPU_INDEX"); GPU_UUID=$(trim "$GPU_UUID"); GPU_NAME=$(trim "$GPU_NAME")
  PCI_DEVICE_ID=$(trim "$PCI_DEVICE_ID")
  POWER_MIN=$(trim "$POWER_MIN"); POWER_MAX=$(trim "$POWER_MAX"); POWER_DEFAULT=$(trim "$POWER_DEFAULT")
  CLOCK_HARDWARE_MAX=$(trim "$CLOCK_HARDWARE_MAX"); FAN_CURRENT=$(trim "$FAN_CURRENT")
  [[ "$GPU_UUID" =~ ^GPU-[A-Za-z0-9-]+$ ]] || die "안전하지 않은 GPU UUID입니다: $GPU_UUID"
  CONFIG_FILE="$CONFIG_DIR/$GPU_UUID.conf"
}

load_config() {
  local selector=$1
  resolve_gpu "$selector"
  POWER_LIMIT=${POWER_DEFAULT%.*}; CLOCK_MAX=${CLOCK_HARDWARE_MAX%.*}; CLOCK_AUTO=1
  FAN_PERCENT=0; FAN_AUTO=1; TUNING_ENABLED=1
  if [[ "${PCI_DEVICE_ID,,}" == 0x20c2* || "${PCI_DEVICE_ID,,}" == 0x2082* ]]; then
    # CMP 170HX stock operating point. Some 8 GB cards carry a 300 W OC VBIOS,
    # so never derive the safe profile from power.max_limit.
    POWER_LIMIT=250; CLOCK_MAX=1410; CLOCK_AUTO=0
  fi
  if [[ -r "$CONFIG_FILE" ]]; then
    # Root-owned file written by this helper; values are validated below.
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
  fi
}

validate() {
  is_uint "$GPU_INDEX" && is_uint "$POWER_LIMIT" && is_uint "$CLOCK_MAX" && is_uint "$CLOCK_AUTO" && is_uint "$FAN_PERCENT" && is_uint "$FAN_AUTO" && is_uint "$TUNING_ENABLED" || die "GPU 설정값은 0 이상의 정수여야 합니다"
  [[ "$POWER_MIN" != "N/A" && "$POWER_MAX" != "N/A" ]] || die "GPU $GPU_INDEX은 전력 제한을 지원하지 않습니다"
  local min_power=${POWER_MIN%.*} max_power=${POWER_MAX%.*}
  (( POWER_LIMIT >= min_power && POWER_LIMIT <= max_power )) || die "파워리밋 허용 범위: ${min_power}~${max_power}W"
  (( CLOCK_AUTO == 0 || CLOCK_AUTO == 1 )) || die "CLOCK_AUTO는 0 또는 1이어야 합니다"
  (( FAN_AUTO == 0 || FAN_AUTO == 1 )) || die "FAN_AUTO는 0 또는 1이어야 합니다"
  (( TUNING_ENABLED == 0 || TUNING_ENABLED == 1 )) || die "TUNING_ENABLED는 0 또는 1이어야 합니다"
  (( CLOCK_MAX >= 210 && CLOCK_MAX <= 5000 )) || die "클럭 상한은 210~5000MHz여야 합니다"
  (( FAN_PERCENT == 0 || (FAN_PERCENT >= 30 && FAN_PERCENT <= 100) )) || die "팬 속도는 자동(0) 또는 30~100%여야 합니다"
}

find_control_display() {
  local sock display
  export XAUTHORITY=/run/user/1000/gdm/Xauthority
  for sock in /tmp/.X11-unix/X*; do
    [[ -S "$sock" ]] || continue
    display=":${sock##*X}"
    if DISPLAY="$display" "$NVIDIA_SETTINGS" -q "[gpu:$GPU_UUID]/GPUFanControlState" >/dev/null 2>&1; then
      printf '%s' "$display"
      return 0
    fi
  done
  return 1
}

apply_fan() {
  local display
  display=$(find_control_display) || return 1
  if (( FAN_AUTO )); then
    DISPLAY="$display" "$NVIDIA_SETTINGS" -a "[gpu:$GPU_UUID]/GPUFanControlState=0" >/dev/null
    echo "GPU $GPU_INDEX 팬 자동 제어 적용 (DISPLAY=$display)"
  else
    DISPLAY="$display" "$NVIDIA_SETTINGS" -a "[gpu:$GPU_UUID]/GPUFanControlState=1" -a "[GPU:$GPU_UUID.FAN]/GPUTargetFanSpeed=$FAN_PERCENT" >/dev/null
    echo "GPU $GPU_INDEX의 연결된 모든 팬에 $FAN_PERCENT% 적용 (DISPLAY=$display)"
  fi
}

write_config() {
  install -d -o root -g root -m 0755 "$CONFIG_DIR"
  umask 022
  local tmp="$CONFIG_FILE.tmp"
  printf 'GPU_UUID=%q\nGPU_INDEX_LAST=%q\nTUNING_ENABLED=%q\nPOWER_LIMIT=%q\nCLOCK_MAX=%q\nCLOCK_AUTO=%q\nFAN_PERCENT=%q\nFAN_AUTO=%q\n' "$GPU_UUID" "$GPU_INDEX" "$TUNING_ENABLED" "$POWER_LIMIT" "$CLOCK_MAX" "$CLOCK_AUTO" "$FAN_PERCENT" "$FAN_AUTO" >"$tmp"
  chown root:root "$tmp"; chmod 0644 "$tmp"; mv "$tmp" "$CONFIG_FILE"
}

apply_one() {
  local selector=$1
  load_config "$selector"; validate
  if (( ! TUNING_ENABLED )); then
    echo "GPU $GPU_INDEX ($GPU_UUID): 저장 설정 비활성화 — 건너뜀"
    return 0
  fi
  nvidia-smi -i "$GPU_UUID" -pl "$POWER_LIMIT" >/dev/null
  if (( CLOCK_AUTO )); then nvidia-smi -i "$GPU_UUID" -rgc >/dev/null; else nvidia-smi -i "$GPU_UUID" -lgc "0,$CLOCK_MAX" >/dev/null; fi
  apply_fan || echo "GPU $GPU_INDEX 팬 제어는 현재 X 세션에 노출되지 않아 건너뜁니다" >&2
  echo "GPU $GPU_INDEX ($GPU_UUID): ${POWER_LIMIT}W / $([[ $CLOCK_AUTO == 1 ]] && echo auto || echo ${CLOCK_MAX}MHz) / fan $([[ $FAN_AUTO == 1 ]] && echo auto || echo ${FAN_PERCENT}%)"
}

apply_saved() {
  local file uuid found=0
  if [[ -d "$CONFIG_DIR" ]]; then
    for file in "$CONFIG_DIR"/GPU-*.conf; do
      [[ -f "$file" ]] || continue
      uuid=$(awk -F= '$1 == "GPU_UUID" { print $2 }' "$file" | tail -n1)
      [[ "$uuid" =~ ^GPU-[A-Za-z0-9-]+$ ]] || continue
      found=1; apply_one "$uuid" || echo "저장된 GPU 설정 적용 실패: $uuid" >&2
    done
  fi
  (( found )) || echo "저장된 UUID별 GPU 설정 없음 — 모든 GPU 건너뜀"
}

case "${1:-apply}" in
  apply) if [[ $# -eq 2 ]]; then apply_one "$2"; else apply_saved; fi ;;
  set)
    [[ $# -eq 5 ]] || die "사용법: $0 set GPU POWER_W CLOCK_MHZ FAN_PERCENT(0=auto)"
    load_config "$2"; TUNING_ENABLED=1; POWER_LIMIT=$3; CLOCK_MAX=$4; CLOCK_AUTO=0; FAN_PERCENT=$5
    if (( FAN_PERCENT == 0 )); then FAN_AUTO=1; else FAN_AUTO=0; fi
    validate; write_config; apply_one "$GPU_UUID"
    ;;
  reset)
    [[ $# -eq 2 ]] || die "사용법: $0 reset GPU"
    load_config "$2"
    if [[ "${PCI_DEVICE_ID,,}" == 0x20c2* || "${PCI_DEVICE_ID,,}" == 0x2082* ]]; then
      POWER_LIMIT=250; CLOCK_MAX=1410; CLOCK_AUTO=0
    else
      POWER_LIMIT=${POWER_DEFAULT%.*}; CLOCK_MAX=${CLOCK_HARDWARE_MAX%.*}; CLOCK_AUTO=1
    fi
    TUNING_ENABLED=1; FAN_PERCENT=0; FAN_AUTO=1
    validate; write_config; apply_one "$GPU_UUID"; echo "GPU $GPU_INDEX ($GPU_UUID) 권장 기본값 적용"
    ;;
  disable)
    [[ $# -eq 2 ]] || die "사용법: $0 disable GPU"
    load_config "$2"; TUNING_ENABLED=0; validate; write_config
    echo "GPU $GPU_INDEX ($GPU_UUID) 저장 설정 비활성화 (현재 실행값은 변경하지 않음)"
    ;;
  list) if [[ -d "$CONFIG_DIR" ]]; then grep -H . "$CONFIG_DIR"/GPU-*.conf 2>/dev/null || true; fi ;;
  *) die "지원하지 않는 명령: $1" ;;
esac
