#!/usr/bin/env python3
"""Root-owned, argument-restricted UEFI BootNext helper for main_server."""

import json
import re
import subprocess
import sys


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(2)


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, capture_output=True, text=True, timeout=20)
    if result.returncode:
        fail((result.stderr or result.stdout).strip() or "명령 실행 실패")
    return result


def state() -> dict:
    output = run(["/usr/bin/efibootmgr"]).stdout
    entries = {}
    current_id = None
    next_id = None
    for line in output.splitlines():
        if line.startswith("BootCurrent:"):
            current_id = line.split(":", 1)[1].strip().upper()
        elif line.startswith("BootNext:"):
            next_id = line.split(":", 1)[1].strip().upper()
        else:
            match = re.match(r"Boot([0-9A-Fa-f]{4})\*?\s+(.+?)(?:\s{2,}|\t|$)", line)
            if match:
                entries[match.group(1).upper()] = match.group(2).strip()
    windows_id = next((key for key, value in entries.items() if "windows boot manager" in value.lower()), None)
    linux_id = next((key for key, value in entries.items() if "ubuntu" in value.lower()), None)
    targets = {
        "windows": {"id": windows_id, "description": entries.get(windows_id, "")} if windows_id else None,
        "linux": {"id": linux_id, "description": entries.get(linux_id, "")} if linux_id else None,
    }
    return {
        "available": bool(windows_id and linux_id), "platform": "linux", "current": "linux",
        "boot_current": current_id, "boot_next": next_id, "targets": targets,
        "error": None if windows_id and linux_id else "Windows Boot Manager 또는 Ubuntu UEFI 항목을 찾지 못했습니다",
    }


action = sys.argv[1] if len(sys.argv) > 1 else "status"
if action == "status" and len(sys.argv) == 2:
    print(json.dumps(state(), ensure_ascii=False))
elif action == "set" and len(sys.argv) == 3:
    target = sys.argv[2]
    if target not in {"windows", "linux"}:
        fail("지원하지 않는 부팅 대상입니다")
    current = state()
    entry = current["targets"].get(target)
    if not current["available"] or not entry:
        fail(current["error"] or "UEFI 부팅 항목이 없습니다")
    run(["/usr/bin/efibootmgr", "--bootnext", entry["id"]])
    print(json.dumps({"ok": True, "target": target, "entry": entry}, ensure_ascii=False))
elif action in {"reboot", "shutdown"} and len(sys.argv) == 2:
    # A transient timer lets the HTTP response reach the browser first.
    systemctl_action = "reboot" if action == "reboot" else "poweroff"
    run([
        "/usr/bin/systemd-run", "--quiet", "--collect", f"--unit=main-server-os-{action}",
        "--on-active=3s", "/usr/bin/systemctl", systemctl_action,
    ])
    print(json.dumps({"ok": True, f"{action}_scheduled": True}, ensure_ascii=False))
else:
    fail("usage: main-server-os-boot status|set windows|linux|reboot|shutdown")
