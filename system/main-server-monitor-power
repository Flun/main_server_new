#!/usr/bin/env bash
set -euo pipefail

DDCUTIL=/usr/bin/ddcutil
STATE_FILE=/run/main-server-monitor-power.state
XAUTHORITY_FILE=/run/user/1000/gdm/Xauthority

die() { echo "$*" >&2; exit 2; }

find_display() {
  local socket candidate
  for socket in /tmp/.X11-unix/X*; do
    [[ -S "$socket" ]] || continue
    candidate=":${socket##*X}"
    if DISPLAY="$candidate" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

activate_graphical_vt() {
  local session tty
  while read -r session _; do
    [[ -n "$session" ]] || continue
    [[ $(loginctl show-session "$session" -p Class --value 2>/dev/null || true) == user ]] || continue
    [[ $(loginctl show-session "$session" -p State --value 2>/dev/null || true) == active ]] || continue
    [[ $(loginctl show-session "$session" -p Seat --value 2>/dev/null || true) == seat0 ]] || continue
    tty=$(loginctl show-session "$session" -p TTY --value 2>/dev/null || true)
    if [[ "$tty" =~ ^tty([0-9]+)$ ]]; then
      chvt "${BASH_REMATCH[1]}" >/dev/null 2>&1 || true
      return 0
    fi
  done < <(loginctl list-sessions --no-legend 2>/dev/null || true)
  return 1
}

detect_buses() {
  "$DDCUTIL" detect --brief 2>/dev/null |
    awk '/I2C bus:/ { sub("/dev/i2c-", "", $3); if ($3 ~ /^[0-9]+$/) print $3 }'
}

status() {
  local state=on count=0 cached_buses value bus on_count=0 off_count=0
  if [[ -r "$STATE_FILE" ]]; then
    read -r state count cached_buses <"$STATE_FILE" || true
  fi
  read -r -a buses <<<"${cached_buses:-}"
  if ((${#buses[@]} == 0)); then
    mapfile -t buses < <(detect_buses)
  fi
  for bus in "${buses[@]}"; do
    [[ "$bus" =~ ^[0-9]+$ ]] || continue
    value=$("$DDCUTIL" getvcp D6 --bus "$bus" --terse 2>/dev/null | awk '{print $4; exit}' || true)
    [[ "$value" == x01 ]] && ((on_count += 1))
    [[ "$value" == x04 ]] && ((off_count += 1))
  done
  if (( on_count > 0 && off_count == 0 )); then
    state=on
    count=$on_count
  elif (( off_count > 0 && on_count == 0 )); then
    state=off
    count=$off_count
  fi
  if [[ ! "$count" =~ ^[0-9]+$ ]] || (( count == 0 )); then
    count=${#buses[@]}
    printf 'on %s %s\n' "$count" "${buses[*]}" >"$STATE_FILE"
    chmod 0644 "$STATE_FILE"
    state=on
  fi
  if (( count == 0 )); then
    echo "unavailable unknown 0"
  else
    [[ "$state" == off ]] || state=on
    echo "available $state $count"
  fi
}

power_off() {
  local bus successes=0
  mapfile -t buses < <(detect_buses)
  ((${#buses[@]} > 0)) || die "DDC/CI 모니터를 찾지 못했습니다"
  for bus in "${buses[@]}"; do
    if "$DDCUTIL" getvcp D6 --bus "$bus" >/dev/null 2>&1 &&
       "$DDCUTIL" setvcp D6 04 --bus "$bus" --noverify >/dev/null 2>&1; then
      ((successes += 1))
    fi
  done
  (( successes > 0 )) || die "모니터 전원 끄기 명령을 적용하지 못했습니다"
  # Retain the bus numbers as a recovery hint. Some panels disappear from
  # ddcutil's live detection after entering VCP D6 sleep.
  printf 'off %s %s\n' "$successes" "${buses[*]}" >"$STATE_FILE"
  chmod 0644 "$STATE_FILE"
  echo "off $successes"
}

power_on() {
  local display= output line mode geometry x y rate primary_arg entry mode_ready attempt
  local successes=0 restored=0 cached_state cached_count cached_buses
  local -a detected_buses=()

  # Wake through DDC first. Unlike xrandr, this path also works after GDM/X11
  # has been stopped for compute mode.
  mapfile -t buses < <(detect_buses)
  if ((${#buses[@]} == 0)) && [[ -r "$STATE_FILE" ]]; then
    read -r cached_state cached_count cached_buses <"$STATE_FILE" || true
    read -r -a buses <<<"${cached_buses:-}"
  fi
  if ! systemctl is-active --quiet display-manager.service; then
    systemctl start getty@tty1.service >/dev/null 2>&1 || true
    chvt 1 >/dev/null 2>&1 || true
    setterm --blank poke --powersave off --powerdown 0 </dev/tty1 >/dev/tty1 2>/dev/null || true
  fi
  for attempt in {1..6}; do
    for bus in "${buses[@]}"; do
      [[ "$bus" =~ ^[0-9]+$ ]] || continue
      if "$DDCUTIL" setvcp D6 01 --bus "$bus" --noverify >/dev/null 2>&1; then
        ((successes += 1))
      fi
    done
    (( successes > 0 )) && break
    if systemctl is-active --quiet display-manager.service; then
      # Never move a live GUI to tty1 merely because a sleeping panel did not
      # answer DDC. Re-select the existing graphical VT instead.
      activate_graphical_vt || true
    else
      # Only a real compute/CLI mode may use VT1 as the DRM wake signal.
      systemctl start getty@tty1.service >/dev/null 2>&1 || true
      chvt 1 >/dev/null 2>&1 || true
      setterm --blank poke --powersave off --powerdown 0 </dev/tty1 >/dev/tty1 2>/dev/null || true
    fi
    sleep 1
    mapfile -t detected_buses < <(detect_buses)
    if ((${#detected_buses[@]} > 0)); then
      buses=("${detected_buses[@]}")
    fi
  done

  # If a live X11 session exists, cycle its outputs too. This is an optional
  # recovery assist for LG DisplayPort panels, never a prerequisite for wake.
  if display=$(find_display); then
    mapfile -t outputs < <(
      DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
        awk '$2 == "connected" && $1 ~ /^(DP|HDMI)-/ { print $1 }'
    )
  else
    outputs=()
  fi

  # Save each active output before cycling DisplayPort. DDC may be unreachable
  # while an LG panel is powered down, but a signal cycle wakes it again.
  declare -a restore_commands=()
  for output in "${outputs[@]}"; do
    line=$(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query | awk -v name="$output" '$1 == name && $2 == "connected" { print; exit }')
    geometry=$(grep -oE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' <<<"$line" | head -n1 || true)
    [[ -n "$geometry" ]] || continue
    mode=${geometry%%+*}; x=${geometry#*+}; x=${x%%+*}; y=${geometry##*+}
    rate=$(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
      awk -v name="$output" '$1 == name { found=1; next } found && $1 ~ /^[0-9]+x[0-9]+$/ { for (i=2; i<=NF; i++) if ($i ~ /\*/) { gsub(/[+*]/, "", $i); print $i; exit } } found && $1 !~ /^[[:space:]]/ { exit }')
    primary_arg=; [[ "$line" == *" primary "* ]] && primary_arg=--primary
    restore_commands+=("$output|$mode|$rate|${x}x${y}|$primary_arg")
  done
  for entry in "${restore_commands[@]}"; do
    IFS='|' read -r output mode rate geometry primary_arg <<<"$entry"
    DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --output "$output" --off
    sleep 1
    # A waking DisplayPort panel can temporarily report no named modes. Bring
    # the connector up with --auto first, then restore the exact mode/rate only
    # after it reappears instead of aborting with "cannot find mode".
    command=(xrandr --output "$output" --auto --pos "$geometry")
    [[ -n "$primary_arg" ]] && command+=("$primary_arg")
    DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" "${command[@]}"
    mode_ready=0
    for attempt in {1..10}; do
      if DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
          awk -v name="$output" -v wanted="$mode" '$1 == name { found=1; next } found && $1 == wanted { yes=1; exit } found && $1 !~ /^[[:space:]]/ { exit } END { exit !yes }'; then
        command=(xrandr --output "$output" --mode "$mode" --pos "$geometry")
        [[ -n "$rate" ]] && command+=(--rate "$rate")
        [[ -n "$primary_arg" ]] && command+=("$primary_arg")
        if DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" "${command[@]}"; then
          mode_ready=1
          break
        fi
      fi
      sleep 0.5
    done
    ((restored += 1))
    sleep 0.5
  done

  # Reapply the complete saved layout after GNOME has reacted to each cycle.
  if ((${#restore_commands[@]} > 0)); then
    command=(xrandr)
    for entry in "${restore_commands[@]}"; do
      IFS='|' read -r output mode rate geometry primary_arg <<<"$entry"
      command+=(--output "$output" --mode "$mode" --pos "$geometry")
      [[ -n "$rate" ]] && command+=(--rate "$rate")
      [[ -n "$primary_arg" ]] && command+=("$primary_arg")
    done
    # Exact replay is best-effort because EDID modes may still be settling;
    # each output is already active at its saved position via --auto above.
    DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" "${command[@]}" >/dev/null 2>&1 || true
  fi

  # A signal cycle may make additional DDC buses visible, so issue wake once
  # more without requiring a readable X display.
  mapfile -t buses < <(detect_buses)
  for bus in "${buses[@]}"; do
    if "$DDCUTIL" setvcp D6 01 --bus "$bus" --noverify >/dev/null 2>&1; then
      ((successes += 1))
    fi
  done
  (( successes > 0 || restored > 0 )) || die "모니터 깨우기 명령을 적용하지 못했습니다"
  if systemctl is-active --quiet display-manager.service; then
    activate_graphical_vt || true
  else
    setterm --blank poke --powersave off --powerdown 0 </dev/tty1 >/dev/tty1 2>/dev/null || true
  fi
  local count=${#buses[@]}
  (( count > 0 )) || count=${#restore_commands[@]}
  (( count > 0 )) || count=1
  printf 'on %s %s\n' "$count" "${buses[*]}" >"$STATE_FILE"
  chmod 0644 "$STATE_FILE"
  echo "on $count"
}

case "${1:-status}" in
  status) status ;;
  off) power_off ;;
  on) power_on ;;
  *) die "사용법: $0 status|off|on" ;;
esac
