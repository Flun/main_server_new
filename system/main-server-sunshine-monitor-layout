#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/sunshine-monitor-layout.state"
XAUTHORITY_FILE="${XAUTHORITY:-/run/user/$(id -u)/gdm/Xauthority}"
SETTINGS_FILE=/srv/main_server_new/sunshine_monitor_settings.json
MONITOR_POWER_HELPER=/usr/local/sbin/main-server-monitor-power

die() { echo "$*" >&2; exit 2; }

find_display() {
  local socket candidate
  if [[ -n "${DISPLAY:-}" ]] && DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query >/dev/null 2>&1; then
    printf '%s' "$DISPLAY"
    return 0
  fi
  for socket in /tmp/.X11-unix/X*; do
    [[ -S "$socket" ]] || continue
    candidate=":${socket##*X}"
    if DISPLAY="$candidate" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query >/dev/null 2>&1; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

save_layout() {
  local display=$1 output line geometry mode x y rate primary
  : >"$STATE_FILE"
  while read -r output; do
    line=$(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
      awk -v name="$output" '$1 == name && $2 == "connected" { print; exit }')
    geometry=$(grep -oE '[0-9]+x[0-9]+\+[0-9]+\+[0-9]+' <<<"$line" | head -n1 || true)
    [[ -n "$geometry" ]] || continue
    mode=${geometry%%+*}; x=${geometry#*+}; x=${x%%+*}; y=${geometry##*+}
    rate=$(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
      awk -v name="$output" '$1 == name { found=1; next } found && $1 ~ /^[0-9]+x[0-9]+$/ { for (i=2; i<=NF; i++) if ($i ~ /\*/) { gsub(/[+*]/, "", $i); print $i; exit } } found && $1 !~ /^[[:space:]]/ { exit }')
    primary=0; [[ "$line" == *" primary "* ]] && primary=1
    printf '%s|%s|%s|%sx%s|%s\n' "$output" "$mode" "$rate" "$x" "$y" "$primary" >>"$STATE_FILE"
  done < <(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
    awk '$2 == "connected" { for (i=3; i<=NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { print $1; break } }')
}

single_monitor() {
  local display primary
  display=$(find_display) || die "활성 X11 화면을 찾지 못했습니다"
  primary=$(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
    awk '$2 == "connected" && $3 == "primary" { print $1; exit }')
  [[ -n "$primary" ]] || die "주 모니터를 찾지 못했습니다"
  save_layout "$display"
  command=(xrandr)
  while read -r output; do
    command+=(--output "$output")
    if [[ "$output" == "$primary" ]]; then
      command+=(--auto --primary --pos 0x0)
    else
      command+=(--off)
    fi
  done < <(DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" xrandr --query |
    awk '$2 == "connected" && $1 ~ /^(DP|HDMI)-/ { print $1 }')
  DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" "${command[@]}"
  echo "single $primary"
}

restore_layout() {
  local display output mode rate pos primary
  display=$(find_display) || die "활성 X11 화면을 찾지 못했습니다"
  [[ -s "$STATE_FILE" ]] || die "복원할 모니터 배치가 없습니다"
  command=(xrandr)
  while IFS='|' read -r output mode rate pos primary; do
    [[ "$output" =~ ^(DP|HDMI)-[0-9]+$ && "$mode" =~ ^[0-9]+x[0-9]+$ && "$pos" =~ ^[0-9]+x[0-9]+$ ]] || continue
    command+=(--output "$output" --mode "$mode" --pos "$pos")
    [[ "$rate" =~ ^[0-9]+([.][0-9]+)?$ ]] && command+=(--rate "$rate")
    [[ "$primary" == 1 ]] && command+=(--primary)
  done <"$STATE_FILE"
  ((${#command[@]} > 1)) || die "복원할 유효한 모니터 배치가 없습니다"
  DISPLAY="$display" XAUTHORITY="$XAUTHORITY_FILE" "${command[@]}"
  echo restore
}

monitor_off_on_connect_enabled() {
  [[ -r "$SETTINGS_FILE" ]] && jq -e '.enabled == true' "$SETTINGS_FILE" >/dev/null 2>&1
}

session_start() {
  single_monitor
  if monitor_off_on_connect_enabled; then
    # Do not abort the Moonlight connection if a panel temporarily rejects
    # DDC; the failed command remains visible in the Sunshine log.
    sudo -n "$MONITOR_POWER_HELPER" off || echo "물리 모니터 자동 끄기 실패" >&2
  fi
}

case "${1:-}" in
  single) single_monitor ;;
  restore) restore_layout ;;
  session-start) session_start ;;
  *) die "사용법: $0 single|restore|session-start" ;;
esac
