#!/usr/bin/env bash
# Stop only the display manager; AI services, SSH, SMB and user services remain.
# Compute mode explicitly activates tty1 so the local monitor shows a usable
# login prompt instead of a black framebuffer left behind by GDM.
set -euo pipefail
DISPLAY_MANAGER=display-manager.service
CONSOLE_GETTY=getty@tty1.service
TARGET_USER=flux
TARGET_UID=1000
USER_RUNTIME=/run/user/$TARGET_UID
die() { echo "$*" >&2; exit 2; }

userctl() {
  runuser -u "$TARGET_USER" -- env \
    XDG_RUNTIME_DIR="$USER_RUNTIME" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$USER_RUNTIME/bus" \
    systemctl --user "$@"
}

restart_optional_user_service() {
  local service=$1
  if ! userctl cat "$service" >/dev/null 2>&1; then
    echo "선택 서비스 없음, 건너뜀: $service" >&2
    return 0
  fi
  if ! userctl restart "$service"; then
    echo "선택 서비스 재시작 실패, GUI 전환은 유지: $service" >&2
  fi
}

find_active_desktop_session() {
  local session
  while read -r session _; do
    [[ -n "$session" ]] || continue
    [[ $(loginctl show-session "$session" -p Name --value 2>/dev/null || true) == "$TARGET_USER" ]] || continue
    [[ $(loginctl show-session "$session" -p Class --value 2>/dev/null || true) == user ]] || continue
    [[ $(loginctl show-session "$session" -p State --value 2>/dev/null || true) == active ]] || continue
    [[ $(loginctl show-session "$session" -p Seat --value 2>/dev/null || true) == seat0 ]] || continue
    printf '%s' "$session"
    return 0
  done < <(loginctl list-sessions --no-legend 2>/dev/null || true)
  return 1
}

wait_for_desktop_session() {
  local attempt session
  for attempt in {1..60}; do
    if session=$(find_active_desktop_session); then
      printf '%s' "$session"
      return 0
    fi
    sleep 0.5
  done
  return 1
}

wait_for_gnome_ready() {
  local attempt
  for attempt in {1..120}; do
    if pgrep -u "$TARGET_UID" -x gnome-shell >/dev/null 2>&1 &&
       userctl is-active --quiet gnome-session-initialized.target &&
       userctl is-active --quiet org.gnome.Shell@x11.service &&
       runuser -u "$TARGET_USER" -- env XAUTHORITY="$USER_RUNTIME/gdm/Xauthority" \
         bash -c 'for socket in /tmp/.X11-unix/X*; do [[ -S "$socket" ]] || continue; DISPLAY=":${socket##*X}" xrandr --query >/dev/null 2>&1 && exit 0; done; exit 1'; then
      # The shell can report active before its extensions, input handling and
      # desktop surfaces have completed their first frame.
      sleep 4
      return 0
    fi
    sleep 0.5
  done
  return 1
}

activate_gui_vt() {
  local session tty attempt
  for attempt in {1..30}; do
    if session=$(find_active_desktop_session); then
      tty=$(loginctl show-session "$session" -p TTY --value 2>/dev/null || true)
      if [[ "$tty" =~ ^tty([0-9]+)$ ]]; then
        chvt "${BASH_REMATCH[1]}"
        return 0
      fi
    fi
    sleep 0.5
  done
  return 1
}

case "${1:-}" in
  set)
    case "${2:-}" in
      gui)
        systemctl stop "$CONSOLE_GETTY" 2>/dev/null || true
        systemctl start "$DISPLAY_MANAGER"
        wait_for_desktop_session >/dev/null || die "GDM은 시작됐지만 flux 자동 로그인 세션이 30초 안에 생성되지 않았습니다"
        wait_for_gnome_ready || die "flux 로그인은 됐지만 GNOME Shell이 60초 안에 준비되지 않았습니다"
        activate_gui_vt || true
        # GDM greeter가 아니라 새 flux 세션의 DISPLAY/PipeWire에 다시 붙인다.
        # 원격 데스크톱 서비스는 GUI 전환의 부가 기능이다. 설치되지 않았거나
        # 재시작에 실패해도 이미 성공한 GDM/GNOME 전환을 실패로 되돌리지 않는다.
        restart_optional_user_service gnome-remote-desktop.service
        restart_optional_user_service sunshine.service
        echo gui
        ;;
      cli)
        # These services cannot capture a desktop after GDM stops. Stop them
        # explicitly to release their X11/NvFBC resources; GUI mode starts them
        # again only after the new flux session is ready.
        userctl stop sunshine.service gnome-remote-desktop.service 2>/dev/null || true
        systemctl stop "$DISPLAY_MANAGER"
        systemctl start "$CONSOLE_GETTY"
        chvt 1
        echo cli
        ;;
      *) die "usage: $0 set gui|cli" ;;
    esac ;;
  *) die "usage: $0 set gui|cli" ;;
esac
